#!/usr/bin/env bash
# vpnrouter-headless - Bounded deterministic launcher wrapper for VPNRouter.Headless
# Omarchy Quattro Plugin: io.github.pavellizunov.vpnrouter
#
# Invariants:
# 1. Bounded deterministic binary resolution: checks only single plugin-relative
#    payload directory (bin/backend/VPNRouter.Headless) or system-installed
#    /usr/lib/vpnrouter-headless/VPNRouter.Headless.
#    NEVER searches PATH; NEVER performs network downloads; NEVER elevates via sudo/pkexec.
#    NO environment variable overrides or testing backdoors.
# 2. Strict protocol v1 argument filtering: forwards ONLY authorized arguments
#    (--stdio, --data-dir <ABSOLUTE_DIR>).
#    Optional --help / -h is generated locally without executing the backend.
#    Rejects unauthorized flags and arbitrary input to prevent command/argument injection.
# 3. Preserves process lifecycle via exec: direct standard I/O streams, signal handling.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
plugin_dir="$(cd -- "$script_dir/.." && pwd -P)"

# Deterministic backend resolution (NO PATH SEARCH, NO ENV OVERRIDE)
backend_bin=""
packaged_bin="$plugin_dir/bin/backend/VPNRouter.Headless"
system_bin="/usr/lib/vpnrouter-headless/VPNRouter.Headless"

# Reject symlinks to enforce zero-symlink invariant and prevent traversal
if [[ -L "$packaged_bin" ]]; then
  printf '%s\n' "vpnrouter-headless: error: packaged backend executable must not be a symlink: $packaged_bin" >&2
  exit 1
fi
if [[ -L "$system_bin" ]]; then
  printf '%s\n' "vpnrouter-headless: error: system backend executable must not be a symlink: $system_bin" >&2
  exit 1
fi

if [[ -f "$packaged_bin" && -x "$packaged_bin" ]]; then
  backend_bin="$packaged_bin"
elif [[ -f "$system_bin" && -x "$system_bin" ]]; then
  backend_bin="$system_bin"
else
  printf '%s\n' "vpnrouter-headless: error: VPNRouter.Headless backend executable not found." >&2
  printf '%s\n' "Checked deterministic locations:" >&2
  printf '%s\n' "  1) Packaged backend: $packaged_bin" >&2
  printf '%s\n' "  2) System installed binary: $system_bin" >&2
  printf '%s\n' "The upstream backend is in active development in https://github.com/PavelLizunov/VPNRouter." >&2
  printf '%s\n' "Please run ./setup --backend-dir <PATH> with a built backend directory." >&2
  exit 1
fi

show_help() {
  cat << 'EOF'
Usage: vpnrouter-headless [--stdio] [--data-dir ABSOLUTE_PATH] [--help]

Bounded launcher wrapper for VPNRouter.Headless under Omarchy Quattro.

Arguments:
  --stdio                    Run in standard I/O wire protocol v1 mode (required by host)
  --data-dir ABSOLUTE_PATH   Specify absolute configuration and data directory
  --help, -h                 Display this help message (generated locally)
EOF
}

# Parse and validate arguments against Protocol v1 contract
data_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --stdio)
      shift
      ;;
    --data-dir)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' "vpnrouter-headless: error: --data-dir requires an absolute directory path argument" >&2
        exit 2
      fi
      if [[ "$2" != /* ]]; then
        printf '%s\n' "vpnrouter-headless: error: --data-dir path must be absolute (got '$2')" >&2
        exit 2
      fi
      data_dir="$2"
      shift 2
      ;;
    --help|-h)
      show_help
      exit 0
      ;;
    *)
      printf '%s\n' "vpnrouter-headless: error: rejected unauthorized argument '$1' (violates protocol v1 contract)" >&2
      exit 2
      ;;
  esac
done

# Execute backend with strict contract: --stdio and optional --data-dir
if [[ -n "$data_dir" ]]; then
  exec "$backend_bin" --stdio --data-dir "$data_dir"
else
  exec "$backend_bin" --stdio
fi
